// karakuri 自身の devcontainer（Docker Compose 構成が既定）。
// base イメージの参照規律は Dockerfile のコメントを参照（1 つ前の実証済み
// リリースへの完全版 pin。他プロジェクトの浮動タグ :1 とは意図的に違う）。
//
// **dockerComposeFile を使うと runArgs は黙って無視される。** cap_add・マウント・
// 環境変数は docker-compose.yaml 側に書く。
{
	"name": "@himorogy/karakuri development container",
	"dockerComposeFile": "docker-compose.yaml",
	"service": "dev",
	"features": {
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
	},
	"customizations": {
		"vscode": {
			"extensions": ["anthropic.claude-code", "biomejs.biome"],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "zsh",
				"terminal.integrated.profiles.linux": {
					"bash": {
						"path": "bash",
						"icon": "terminal-bash"
					},
					"zsh": {
						"path": "zsh"
					}
				}
			}
		}
	},
	// Compose では "stopCompose" が既定。ウィンドウを閉じてもコンテナを止めない。
	"shutdownAction": "none",
	"remoteUser": "node",
	"workspaceFolder": "/workspaces/karakuri",
	// 個人設定フック (/personal はホスト側 ~/.config/devc-personal の ro mount) も
	// ここで実行する。取得を伴うため firewall 適用前のこの段に置く。フック本体は
	// コンテナ内の主体には書けない。根拠は examples/devcontainer.json のコメント。
	"postCreateCommand": "if [ -x /personal/setup.sh ]; then /personal/setup.sh; fi",
	// ファイアウォールを毎起動時に適用する。waitFor と組み合わせているため、適用に
	// 失敗した状態でエディタが使えるようになる前に失敗が表面化する。
	"postStartCommand": "sudo /usr/local/bin/init-project-firewall.sh",
	"waitFor": "postStartCommand"
}
