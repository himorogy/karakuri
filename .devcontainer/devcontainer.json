// 案 A（Docker Compose）の検証用。既定は devcontainer.json（案 B）のまま。
// 使うときは devcontainer.json と入れ替える。手順は
// packages/egress-guard/docs/verification-record.md §6.22。
//
// 案 B から消えたもの: initializeCommand / runArgs / mounts / workspaceMount /
// containerEnv。いずれも docker-compose.yml 側へ移した。
// **dockerComposeFile を使うと runArgs は黙って無視される。** ここに書き戻しても
// cap_add は効かないため、egress-guard が起動に失敗する。
{
	"name": "@himorogy/karakuri development container",
	"dockerComposeFile": "docker-compose.yml",
	"service": "dev",
	"features": {
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
	},
	"customizations": {
		"vscode": {
			"extensions": ["anthropic.claude-code", "biomejs.biome"],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "zsh",
				"terminal.integrated.profiles.linux": {
					"bash": {
						"path": "bash",
						"icon": "terminal-bash"
					},
					"zsh": {
						"path": "zsh"
					}
				}
			}
		}
	},
	// Compose では "stopCompose" が既定。案 B と挙動を揃えるため none にする。
	"shutdownAction": "none",
	"remoteUser": "node",
	"workspaceFolder": "/workspaces/karakuri",
	"postCreateCommand": "bash ./.devcontainer/post-create.sh",
	// ファイアウォールを毎起動時に適用する。waitFor と組み合わせているため、適用に
	// 失敗した状態でエディタが使えるようになる前に失敗が表面化する。
	"postStartCommand": "sudo /usr/local/bin/init-project-firewall.sh",
	"waitFor": "postStartCommand"
}
