{
	"name": "@himorogy/egress-guard",
	"version": "0.0.0",
	"description": "Allowlist-based egress firewall bootstrap for development containers",
	"keywords": [
		"egress",
		"firewall",
		"iptables",
		"ipset",
		"devcontainer",
		"allowlist",
		"network-policy"
	],
	"type": "module",
	"scripts": {
		"test": "bash tests/firewall-config.test.sh && bash tests/firewall-rules.test.sh",
		"lint:sh": "shellcheck -x --shell=bash --severity=style scripts/*.sh tests/*.sh"
	},
	"files": [
		"scripts",
		"templates",
		"docs",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	}
}
