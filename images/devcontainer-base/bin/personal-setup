#!/bin/sh
# /usr/local/bin/personal-setup
#
# postCreateCommand から呼ばれる。個人設定フック (既定 /personal/setup.sh) を
# 実行する。dev は internal ネットワークだけに載る構成のため、この時点で
# フックは外部へ出られない。取得はホスト側で済ませて /personal に置き、
# フックはそこから配置・設定するだけにする。
#
# 実行主体は変えない。postCreateCommand は remoteUser (node) で走り、この
# スクリプトも sudo を挟まずそのユーザーのまま実行する。
#
# PERSONAL_SETUP_HOOK はテストがフックのパスを差し替えるための口
# (git-identity-setup の GIT_IDENTITY_SETUP_FETCH_CMD と同型)。
set -eu

HOOK="${PERSONAL_SETUP_HOOK:-/personal/setup.sh}"

if [ -x "$HOOK" ]; then
  exec "$HOOK"
fi
