// プロジェクト側 devcontainer.json の雛形。
// .devcontainer/devcontainer.json としてコピーし、<your-project> を差し替える。
//
// egress-guard が第一に推奨する Docker Compose 構成。ネットワーク・cap・ポート転送・
// 環境変数・マウントは docker-compose.yaml 側にある。理由と、Compose を使わない場合の
// 代替 (initializeCommand でユーザー定義ネットワークを用意する案) は
// packages/egress-guard/README.md の「ネットワーク構成（推奨）」を参照。
{
	"name": "<your-project>",

	"dockerComposeFile": "docker-compose.yaml",
	"service": "dev",

	// docker-compose.yaml は親ディレクトリを /workspaces に載せているので、
	// リポジトリ本体はその 1 階層下に現れる。
	//
	// **マウント先と食い違わせないこと。** ずれてもエラーでは止まらず、エディタが
	// 空の（存在しない）フォルダを開く形で現れる。かつては postCreateCommand の
	// 相対パス実行が exit 127 で落ちて検出器になっていたが、その形の実行は
	// 無くなったので、症状から原因に辿り着きにくい。
	"workspaceFolder": "/workspaces/<your-project>",

	"remoteUser": "node",

	// Claude Code は Feature で入れる。curl | bash と違いバージョンが
	// devcontainer-lock.json に固定される。**このロックファイルはコミットすること。**
	"features": {
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
	},

	"customizations": {
		"vscode": {
			"extensions": ["anthropic.claude-code", "biomejs.biome"],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "zsh",
				"terminal.integrated.profiles.linux": {
					"bash": {
						"path": "bash",
						"icon": "terminal-bash"
					},
					"zsh": {
						"path": "zsh"
					}
				}
			}
		}
	},

	// 平文 env の検査に initializeCommand は要らない。ベースイメージが core.hooksPath を
	// 焼き込んでおり、コンテナ内でのコミットは全リポジトリで pre-commit hook に通る。
	// ホストの GUI git クライアントのようにコンテナの外からコミットする経路には
	// この設定が届かないので、そちらは @himorogy/env-guard をプロジェクトに入れて塞ぐ。

	// 取得を伴うセットアップはここに置く。firewall の適用後には外から取ってこられない。
	//
	// 注意: features も postCreateCommand も egress-guard が適用される「前」に、
	// 復号キーが注入済みのコンテナ内で走る。egress-guard はコンテナ作成中の通信を
	// 保護しない。詳細は README の「保護範囲」を参照。
	//
	// 個人設定フック（/personal は docker-compose.yaml がホスト側ディレクトリを
	// ro mount している）もここで実行する。個人セットアップの実体はツール取得で、
	// firewall 適用後では宛先が許可されておらずブロックされるため、他の取得を伴う
	// セットアップと同じくこの段に置く。作成時 1 回という postCreate の意味論も
	// インストール系に合う。firewall 前の実行だが、フック本体はホスト側 ro で
	// コンテナ内の主体には書けず、書けるのは tracked なこのファイルと同じく
	// 開発者本人だけ。信頼水準は変わらない。
	"postCreateCommand": "if [ -x /personal/setup.sh ]; then /personal/setup.sh; fi",

	// egress-guard はコンテナ起動のたびに適用する（iptables は永続しない）。
	// 引数は渡さない。sudoers 側で引数付き実行を拒否している。
	"postStartCommand": "sudo /usr/local/bin/init-project-firewall.sh",

	// エディタが接続を報告するまでに firewall の適用を終わらせる。
	// これは UI がどの lifecycle command を待つかの指定であって、
	// セキュリティ境界ではない。先行するコマンドの通信は制限されない。
	"waitFor": "postStartCommand"

	// shutdownAction は Compose では "stopCompose" が既定。ウィンドウを閉じるとコンテナが
	// 止まる。複数プロジェクトを開いたまま ipset を読むときにコンテナを取り違えないので、
	// 既定のままにしてある。止めたくない場合だけ "none" を足す。
}
