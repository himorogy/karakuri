// プロジェクト側 devcontainer.json の雛形。
// .devcontainer/devcontainer.json としてコピーし、<your-project> を差し替える。
//
// egress-guard が第一に推奨する Docker Compose 構成。ネットワーク・cap・ポート転送・
// 環境変数・マウントは docker-compose.yml 側にある。理由と、Compose を使わない場合の
// 代替 (initializeCommand でユーザー定義ネットワークを用意する案) は
// packages/egress-guard/README.md の「ネットワーク構成（推奨）」を参照。
{
	"name": "<your-project>",

	"dockerComposeFile": "docker-compose.yml",
	"service": "dev",

	// **docker-compose.yml の volumes のマウント先と必ず一致させること。**
	// ずれると postCreateCommand が exit 127 で落ちる。エラーはコマンドの側に出るので、
	// 原因がマウント先の不一致だと気づきにくい。
	"workspaceFolder": "/workspace",

	"remoteUser": "node",

	// **runArgs / containerEnv / mounts / workspaceMount はここに書いても効かない。**
	// dockerComposeFile を使うと runArgs は黙って無視される (実測済み)。
	// 書き戻しても cap_add は効かず、egress-guard の適用が失敗する。

	"customizations": {
		"vscode": {
			"extensions": ["anthropic.claude-code", "biomejs.biome"],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "zsh"
			}
		}
	},

	// 平文 env がワークスペースに残っていないかを検査する。これはホスト側で走る。
	// enclave-env を使わないなら消すこと。
	"initializeCommand": "sh node_modules/@himorogy/enclave-env/scripts/init-check-dev.sh",

	// エージェント CLI は Dockerfile ではなくここで入れる。prod 環境の
	// イメージに含めないため。
	//
	// 注意: lifecycle の順序は postCreateCommand → postStartCommand。
	// つまりこの curl は egress-guard が適用される「前」に、復号キーが注入済みの
	// コンテナ内で実行される。egress-guard はコンテナ作成中の通信を保護しない。
	// 詳細は README の「保護範囲」を参照。
	"postCreateCommand": "curl -fsSL https://claude.ai/install.sh | bash",

	// egress-guard はコンテナ起動のたびに適用する（iptables は永続しない）。
	// 引数は渡さない。sudoers 側で引数付き実行を拒否している。
	"postStartCommand": "sudo /usr/local/bin/init-project-firewall.sh",

	// エディタが接続を報告するまでに firewall の適用を終わらせる。
	// これは UI がどの lifecycle command を待つかの指定であって、
	// セキュリティ境界ではない。先行するコマンドの通信は制限されない。
	"waitFor": "postStartCommand"

	// shutdownAction は Compose では "stopCompose" が既定。ウィンドウを閉じるとコンテナが
	// 止まる。複数プロジェクトを開いたまま ipset を読むときにコンテナを取り違えないので、
	// 既定のままにしてある。止めたくない場合だけ "none" を足す。
}
