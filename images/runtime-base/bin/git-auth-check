#!/bin/sh
# /usr/local/bin/git-auth-check
#
# github.com への https 認証が、イメージの意図した経路
# (credential helper /usr/local/bin/git-credential-gh-token ->
# /run/secrets/GH_TOKEN) に落ちているかを、対話シェルの起動ごとに1行で報告
# する。
#
# この報告が要るのは GIT_CONFIG_COUNT が git の持つ唯一のカウンタだからである。
# 利用側が自分の設定を同じ仕組みで足すと、イメージが置いた 2 つのスロットが
# 黙って消え、認証は askpass や別の helper へ落ちる。しかもホスト側の資格情報で
# 成功してしまうため、失敗としては現れない。だから正常時も含めて毎回報告する。
#
# 固定の仕組みと、打ち消している相手は images/runtime-base/Dockerfile の
# ENV GIT_CONFIG_COUNT の直上にある。
#
# 呼び出し元は karakuri-context (対話シェルの起動時)。対話判定と失敗の握り潰しは
# 呼び出し元が持っているので、ここでは持たない。
set -u

expected_helper=/usr/local/bin/git-credential-gh-token
expected_key='credential.https://github.com.helper'

# --- 実効 helper -----------------------------------------------------------------
# --get-urlmatch は URL に一致する設定を、打ち消し (空文字の helper) を適用した
# 後の状態で返す。意図どおりなら出力は自前の helper のパス 1 本になる。設定が
# 1 件も無い場合も rc=0 で空を返すため、判定は rc ではなく出力そのもので行う。
actual_helper=$(git config --get-urlmatch credential.helper https://github.com 2>/dev/null) || actual_helper=""

# --- イメージ固定の生死 ------------------------------------------------------------
# イメージが Dockerfile の ENV で置く 5 変数 (GIT_CONFIG_COUNT / KEY_0 /
# VALUE_0 / KEY_1 / VALUE_1) が、利用側の設定で上書きされずに残っているかを見る。
# VALUE_0 は正常値が空文字であり、未設定と設定した空文字を `${VAR:-}` では
# 区別できないため、`${VAR+set}` で「変数として存在するか」を先に確かめる。
#
# GIT_CONFIG_COUNT は完全一致ではなく 2 以上を許す。README が案内する
# 「イメージの 5 つを引き継いだうえで自分の設定を 2 番以降に足す」利用側の形は
# COUNT を 3 以上にする。スロット 0/1 がイメージのものであることは KEY/VALUE 側の
# 4 本で既に確かめているので、COUNT の完全一致まで求めると、案内どおりに足した
# 利用側を「外れている」と誤検知する。
is_set() {
	eval "[ \"\${$1+set}\" = set ]"
}

fixation=alive
case "${GIT_CONFIG_COUNT-}" in
'' | *[!0-9]*) fixation=broken ;;
*) [ "$GIT_CONFIG_COUNT" -ge 2 ] || fixation=broken ;;
esac
is_set GIT_CONFIG_KEY_0 && [ "$GIT_CONFIG_KEY_0" = "$expected_key" ] || fixation=broken
is_set GIT_CONFIG_VALUE_0 && [ "$GIT_CONFIG_VALUE_0" = "" ] || fixation=broken
is_set GIT_CONFIG_KEY_1 && [ "$GIT_CONFIG_KEY_1" = "$expected_key" ] || fixation=broken
is_set GIT_CONFIG_VALUE_1 && [ "$GIT_CONFIG_VALUE_1" = "$expected_helper" ] || fixation=broken

if [ "$fixation" = alive ]; then
	fixation_label="イメージ固定: 生きている"
else
	fixation_label="イメージ固定: 外れている (GIT_CONFIG_COUNT 系が上書きまたは欠落)"
fi

if [ -z "$actual_helper" ]; then
	actual_label="(無し。askpass か端末のプロンプトへ落ちる)"
else
	actual_label="$actual_helper"
fi

echo "git-auth-check: 実効 helper=$actual_label / $fixation_label"

exit 0
