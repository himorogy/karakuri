#!/bin/sh
# /usr/local/bin/git-auth-check
#
# github.com への https 認証が、イメージの意図した経路 (GIT_ASKPASS ->
# /run/secrets/GH_TOKEN) に落ちているかを確認し、落ちていなければ警告する。
#
# git は credential helper を先に呼び、資格情報が返った時点で解決を確定する。
# GIT_ASKPASS はどの helper も返さなかった場合のフォールバックでしかないので、
# helper が 1 本でも生きていると、認証は注入したトークンではなくその helper が
# 返すもので通る。しかも通ってしまうため、失敗としては現れない。
#
# イメージは GIT_CONFIG_COUNT / GIT_CONFIG_KEY_0 / GIT_CONFIG_VALUE_0 で
# github.com の helper を打ち消してこれを防いでいる
# (docs/prod-secret-isolation-design.md §4.6)。ただし GIT_CONFIG_COUNT は git が
# 持つ唯一のカウンタで、利用側が自分の設定を同じ仕組みで足すと、イメージが置いた
# 0 番が黙って消える。この検査はその「黙って」を潰すためだけにある。
#
# 呼び出し元は prod-context (対話シェルの起動時)。対話判定と失敗の握り潰しは
# 呼び出し元が持っているので、ここでは持たない。
set -u

# --get-urlmatch は URL に一致する設定を、打ち消し (空文字の helper) を適用した
# 後の状態で返す。打ち消しが生きていれば出力は空、死んでいれば生き残っている
# helper の値が出る。設定が 1 件も無い場合も rc=0 で空を返すため、判定は rc では
# なく出力の有無で行う。
helper=$(git config --get-urlmatch credential.helper https://github.com 2>/dev/null) || helper=""
[ -n "$helper" ] || exit 0

# 値そのものを出す。helper の設定値は秘密ではなく (資格情報を返すコマンドで
# あって資格情報ではない)、どこから来た設定かを特定するのに要る。
cat >&2 <<MSG
git-auth-check: github.com の credential helper が生きている:
  $helper
  この helper は GIT_ASKPASS より先に評価されるため、github.com への https 認証は
  /run/secrets/GH_TOKEN ではなくこの helper が返す資格情報で通る。認証自体は成功
  するので、失敗としては現れない。
  このイメージは GIT_CONFIG_COUNT=1 / GIT_CONFIG_KEY_0=credential.https://github.com.helper
  / GIT_CONFIG_VALUE_0= (空) の 3 つで helper を打ち消している。この 3 つが上書き
  されていないか、GIT_CONFIG_COUNT を別の設定にも使っていないかを確認すること。
MSG
exit 0
