#!/bin/sh
# /usr/local/bin/git-credential-gh-token
#
# github.com 向けの git credential helper。VS Code の Dev Containers 拡張は
# 統合ターミナルの environ へ GIT_ASKPASS を注入して上書きしてくるため、
# askpass 側だけを固定してもそちらに勝てない。credential helper は
# gitconfig 側の設定であり、git の解決順で askpass より先に評価されるので、
# helper であれば environ の注入に左右されずに github.com の認証先を
# このスクリプトへ固定できる。
#
# 呼ばれ方: git が `git-credential-gh-token get` のように操作名を第1引数で
# 渡し、protocol=/host=... 等の行を stdin に書いてくる。呼び出し元は
# Dockerfile の GIT_CONFIG_KEY_1=credential.https://github.com.helper /
# GIT_CONFIG_VALUE_1=/usr/local/bin/git-credential-gh-token で、値は絶対
# パスで指定している。helper 名を裸で書くと git は PATH から
# git-credential-<name> を探しに行くが、このイメージの PATH は
# ${NPM_CONFIG_PREFIX}/bin が /usr/local/bin より先に来るため、そこに同名の
# ものを置かれると乗っ取られる (shims セクションと同じ罠)。絶対パス指定は
# その回避。
set -eu

# get 以外 (store / erase、または無指定) では何もしない。この helper は
# /run/secrets/GH_TOKEN を読んで返すだけの読み取り専用で、認証成功後の
# store や失敗時の erase には応答しない。
case "${1:-}" in
get) ;;
*) exit 0 ;;
esac

# protocol=.../host=... 等の行は使わないが、読み捨てないと git 側の書き込み
# が詰まる。
cat >/dev/null

f=/run/secrets/GH_TOKEN

if [ -e "$f" ] && [ -s "$f" ]; then
  # 読み取りは cat の結果を独立した文で変数へ受け、失敗と空を明示的に
  # 判定してから出力する。`password=$(cat "$f")` のように出力へ直接
  # 埋め込む形だと、cat が失敗 (例: mode 000 で読めない) しても出力自体は
  # 空パスワードとして成立してしまい、「読めない」が空値の注入として
  # 素通りする (shims/gh と同じ罠への対処)。
  v=$(cat "$f" 2>/dev/null) || v=""
  if [ -n "$v" ]; then
    printf 'username=%s\n' x-access-token
    printf 'password=%s\n' "$v"
    exit 0
  fi
fi

# ここに来るのは GH_TOKEN が無い・空・読めないのいずれか。理由だけを
# stderr へ 1 行出し、トークンの値そのものは (そもそも読めていないので)
# 出しようがない。
echo "git-credential-gh-token: GH_TOKEN not available: $f" >&2

# git の credential helper 連鎖は、helper が非ゼロで終了しても単に次の
# helper や GIT_ASKPASS へフォールスルーするだけで、それこそが本来防ぎ
# たかった「ホスト側の資格情報で黙って認証が通る」経路そのものになる。
# stdout へ quit=1 を出すことだけが、git に「これ以上 helper を連鎖させず
# 失敗しろ」と伝える手段になる。
echo "quit=1"

# 失敗の伝達は上の quit=1 が担うため、終了コードは常に 0 にする。非ゼロで
# 終えても git は黙って次の helper (無い) や askpass へ進むだけで、quit=1
# 自体が無効になるわけではないが、ここで exit を非ゼロにする意味が無い
# ことを明示するために揃えておく。
exit 0
