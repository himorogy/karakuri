#!/bin/sh
# /usr/local/bin/dotenvx  （実体は /opt/tools/bin/dotenvx に退避してある）
#
# 固定 1 変数ではなく DOTENV_PRIVATE_KEY_* の汎用ループにする。鍵変数名は
# 環境ごとに異なり (_PROD / _DEVELOPMENT / _LOCAL)、prod container には
# _PROD だけが、dev container には dev 向けの鍵だけが /run/secrets に
# 置かれる想定。複数の鍵が同時に注入されても、dotenvx は -f のファイル名
# 規約 (.env.prod → _PROD) で対応する鍵を選ぶため、ここでは全て export
# すればよい (docs/prod-secret-isolation-design.md §4.3)。
#
# dotenvx には raw な鍵ファイルを直接読む仕組みがないため (-fk は dotenv
# 形式のファイルを要求する)、shim による env 注入が正当な経路になる。
set -eu
for f in /run/secrets/DOTENV_PRIVATE_KEY_*; do
  [ -e "$f" ] || continue          # glob 不一致 (ファイルなし) は素通し
  [ -s "$f" ] || { echo "empty secret: $f" >&2; exit 1; }
  # 読み取りは export の中ではなく独立した文で行う。
  # `export "NAME=$(cat "$f")"` の形だと、cat が失敗しても終了コードは
  # export のものになるため set -e が発火しない。「ファイルは存在し非空
  # だが読めない (例: mode 000)」が空値の注入として素通りしてしまう —
  # この設計が排除したい「秘密の欠落が沈黙した成功になる」形そのもの。
  # v=$(cat "$f") || exit 1 と独立した文で読み、非空を再検査してから
  # export する (docs/prod-secret-isolation-design.md §4.3)。
  v=$(cat "$f") || exit 1
  [ -n "$v" ] || { echo "empty secret: $f" >&2; exit 1; }
  export "${f##*/}=$v"
done

# --- --strict 忘れの警告 --------------------------------------------------------
# dotenvx は復号に失敗しても非ゼロ終了せず、暗号文をそのまま値として注入した
# うえで rc=0 を返す (実測済み)。prod ではこれを `--strict` で顕在化させる運用
# だが、イメージ側では強制しない。`--strict` は `--convention flow` のような
# 正当な重ね掛けを壊すため (実測: `.env.development.local` 不在で rc=1 になる)。
# 強制はしないが、忘れたときに黙ってはいない。
#
# ここで見ているのは「環境」ではなく「注入済みの prod 鍵ファイルの有無」で
# ある。この shim の三値意味論 (存在→注入 / 空→エラー / 不在→素通し) は環境を
# 判別しない設計であり、prod 鍵の観測はその設計と矛盾しない。dev には prod 鍵
# が来ない設計なので、dev では一度も出ない。
#
# `run` の判定は「引数のどこかに run という語がある」で足りる。`-- run` のよう
# に区切り以降へ現れた語を拾って空振りする可能性はあるが、警告は害の無い側なの
# で許容する。`--strict=` 形式や `--strict` が別の値を従える形は dotenvx には
# 無いため、単純な語一致でよい。
has_run=0
has_strict=0
for a in "$@"; do
  case "$a" in
  run) has_run=1 ;;
  --strict) has_strict=1 ;;
  esac
done
if [ "$has_run" -eq 1 ] && [ "$has_strict" -eq 0 ] &&
  [ -e /run/secrets/DOTENV_PRIVATE_KEY_PROD ]; then
  echo "dotenvx: WARNING: production key is injected but --strict" >&2
  echo "dotenvx:   is absent. dotenvx exits 0 even when decryption" >&2
  echo "dotenvx:   fails, injecting the ciphertext as the value." >&2
fi

exec env -u NODE_OPTIONS /opt/tools/bin/dotenvx "$@"
