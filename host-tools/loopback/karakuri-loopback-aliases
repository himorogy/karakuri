#!/bin/sh
#
# karakuri-loopback-aliases — 起動時に loopback alias を張り直す
#
# ============================================================================
# このファイルは配布物であって、この場所で実行されるものではない。
# loopback-setup.sh の install が /usr/local/libexec/karakuri-loopback-aliases
# へ複製し、LaunchDaemon（com.karakuri.loopback-aliases）がそれを root で
# 実行する。編集するのはこちら（配布物）で、直したら install を打ち直す。
# ============================================================================
#
# 何をするものか: macOS では 127.0.0.1 以外の loopback アドレス
# （127.0.1.1 など）は、`ifconfig lo0 alias <addr> up` で明示的に有効化しない
# 限り bind できない。しかも張った結果はカーネルの中にしか無いので再起動で
# 消える。プロジェクトごとに別の loopback アドレスへ bind する運用
# （そうするとプロジェクト間でポート番号を使い回せる）は、この一手間を
# 起動のたびに再現しないと成り立たない。それを launchd に代行させるための
# 実体がこのスクリプトである。
#
# 設定ファイルを /usr/local/etc ではなく /etc に置く理由:
# macOS の /usr/local は admin グループに書き込み権がある（Homebrew が
# そこへ入るための既定である）。root で走る daemon が admin 権限で書き換え
# られるファイルを読む形にすると、admin 権限しか無い相手が root で実行される
# 入力を用意できることになる。ここで読むのは「lo0 に張るアドレス」だけで、
# 下の 127. 制限もあるので実害の幅は狭いが、狭いから許すという判断は次に
# 何かを足したときに残らない。root が読むものは root しか書けない場所に置く、
# という形の方を残す。
#
# POSIX sh で書いてあるのは、これが起動直後に launchd から直接呼ばれるため。
# 依存を /bin/sh と /sbin/ifconfig だけに切っておけば、利用者のシェル環境
# （bash の版・PATH の中身）が何であっても起動時の挙動が変わらない。

set -eu

# glob を止める。下で `set -- $line` として行を語に割っており、そのままだと
# 設定ファイルに `*` が混ざっていたときにカレントディレクトリのファイル名へ
# 展開される。ここで読むのは root しか書けないファイルなので現実の脅威では
# ないが、語に割る箇所を書いた以上は展開も止めておく。
set -f

CONF=/etc/karakuri/loopback-aliases

# 設定ファイルが無い／読めないなら何もしない。install だけ済ませてまだ
# 1 つも add していない状態は正常であり、それを失敗として log に残すと
# 「毎起動 1 行のエラー」を読み飛ばす習慣を作ってしまう。
[ -r "$CONF" ] || exit 0

# `|| [ -n "$line" ]` は、最終行が改行で終わっていないファイルのため。
# read は EOF に当たると非ゼロを返すが、その時点で読んだ分は $line に
# 入っている。これが無いと、手で編集したときに最後の 1 行だけ黙って
# 無視される。無限ループにはならない: read は EOF で変数を空にしてから
# 非ゼロを返すので、その行を処理した次の周回で条件が偽になる。
line=''
while IFS= read -r line || [ -n "$line" ]; do
	# 行を語に割って、1 番目のフィールドだけをアドレスとして見る。
	# 2 番目以降を無視するのは、行末に覚え書きを書けるようにするため
	# （`127.0.1.1  # acme.test` のような書き方を将来許すための余地）。
	# shellcheck disable=SC2086 # 語分割は意図的。上の set -f で glob は止めてある
	set -- $line
	[ "$#" -gt 0 ] || continue
	addr="$1"

	# 空行は上の $# で落ちる。# で始まる行はここで落とす。
	case "$addr" in
	'#'*) continue ;;
	esac

	# 127.0.0.1 は名指しで読み飛ばす。下の `127.*` はこれも受理してしまうが、
	# 受理すると loopback-setup.sh 側（_check_addr）が 127.0.0.1 を拒否するのと
	# 食い違う。食い違ったまま手で設定ファイルへ書かれると、daemon だけが
	# 起動時に張り、`karakuri-loopback list` は「設定にあるのに lo0 に無い」と
	# 警告を出し続ける（あちらは 127.0.0.1 を lo0 の一覧から外しているため）。
	# どちらの言い分が正しいのかを利用者が読み解く材料は、どこにも無い。
	# ここで同じ言い方をして落とすと、その状態が生まれなくなる。
	#
	# 黙って飛ばさず log に残すのは、これが「書いたのに効かない」側の
	# 読み飛ばしだからである（空行やコメントと違って、書いた人には意図がある）。
	case "$addr" in
	127.0.0.1)
		echo "karakuri-loopback-aliases: skipping '${addr}' from ${CONF}: 127.0.0.1 is always on lo0, so there is nothing to alias — it is not managed by this tool" >&2
		continue
		;;
	esac

	# 127. で始まるものだけを受理する。設定ファイルは root しか書けない
	# 場所にあるので「信用できない入力を濾す」ためではなく、このスクリプト
	# を読んだ人が、実行を追わずに「これは lo0 の loopback alias 以外を
	# 作れない」と言い切れる状態にするために置いてある。ifconfig に渡る
	# 値の範囲がこの 1 箇所で閉じている、というのがここの効き目である。
	case "$addr" in
	127.*) ;;
	*)
		echo "karakuri-loopback-aliases: skipping '${addr}' from ${CONF}: only addresses in 127.0.0.0/8 are managed here" >&2
		continue
		;;
	esac

	# 失敗しても残りを処理する。1 行の書き損じ（127. で始まってはいるが
	# アドレスとして不正、など）で、それ以降のプロジェクトのアドレスが
	# 全部張られないまま起動が終わる方が困る。`set -e` があるので、
	# 明示的に握らないとここで止まる。
	#
	# 逆に、127. で始まってさえいれば形が壊れていても ifconfig までは
	# 通す。形の検査をここで作り込むより、ifconfig 自身に判定させて
	# その言い分をそのまま log へ残す方が、原因がそのまま読める。
	/sbin/ifconfig lo0 alias "$addr" up ||
		echo "karakuri-loopback-aliases: 'ifconfig lo0 alias ${addr} up' failed" >&2
done <"$CONF"

exit 0
